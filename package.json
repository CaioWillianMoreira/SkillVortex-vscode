{
  "name": "skillvortex-extension",
  "displayName": "SkillVortex Extension",
  "description": "Cofre local e portatil de Markdown para projetos e agentes de IA.",
  "version": "0.1.0",
  "publisher": "skillvortex",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": ["onCommand:skillVortex.open"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "commands": [
      { "command": "skillVortex.open", "title": "SkillVortex: Abrir biblioteca" },
      { "command": "skillVortex.createVault", "title": "SkillVortex: Criar cofre" },
      { "command": "skillVortex.openVault", "title": "SkillVortex: Abrir cofre" },
      { "command": "skillVortex.migrateDesktop", "title": "SkillVortex: Importar banco do desktop" }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview/tsconfig.json",
    "build": "tsc && esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --outfile=dist/extension.js && node scripts/build-assets.cjs && vite build --config webview/vite.config.ts",
    "test": "jest --runInBand",
    "test:host": "npm run build && node scripts/test-host.cjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license --out release/skillvortex-extension-0.1.0.vsix"
  },
  "dependencies": {
    "sql.js": "^1.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.6.0",
    "antd": "^5.29.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
